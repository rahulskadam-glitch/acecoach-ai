NEXT_PUBLIC_APP_NAME=AceCoach AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated OAuth providers that are actually configured in Supabase.
# Supported values: google, apple, microsoft (or azure), facebook.
# Buttons are hidden unless listed here.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Server-only keys. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Local/hosted frame-by-frame analysis API.
ANALYSIS_API_URL=http://127.0.0.1:8000

# Set the same strong secret in both the Next.js app and Python API environment.
ANALYSIS_API_KEY=replace-with-a-long-random-secret
# Required comma-separated video host allowlist, e.g. your-project.supabase.co
VIDEO_ALLOWED_HOSTS=your-project-reference.supabase.co
# Development-only escape hatch. Keep false; production rejects true.
ALLOW_UNLISTED_VIDEO_HOSTS=false
MAX_VIDEO_DOWNLOAD_BYTES=524288000
# Analysis service hardening.
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
ANALYSIS_MAX_CONCURRENT_JOBS=1
MAX_ANALYSIS_SECONDS=30
MAX_ANALYSIS_FRAMES=3600
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MAX_VIDEO_PIXELS=8294400
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=90

