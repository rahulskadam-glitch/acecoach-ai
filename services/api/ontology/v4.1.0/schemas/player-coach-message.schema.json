{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acecoach.ai/schemas/player-coach-message.schema.json",
  "title": "AceCoach Player Coach Message",
  "type": "object",
  "required": [
    "coach_read",
    "change",
    "why",
    "feel",
    "watch",
    "train",
    "success",
    "evidence_ids"
  ],
  "properties": {
    "coach_read": {
      "type": "string",
      "minLength": 1
    },
    "keep": {
      "type": [
        "string",
        "null"
      ]
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "feel": {
      "type": "string",
      "minLength": 1
    },
    "watch": {
      "type": "string",
      "minLength": 1
    },
    "train": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "comparison_basis": {
      "type": [
        "object",
        "string"
      ]
    },
    "language_profile_id": {
      "type": "string"
    },
    "surface": {
      "enum": [
        "PLAYER_COACH",
        "COACH_ANALYST"
      ]
    }
  },
  "additionalProperties": true
}
