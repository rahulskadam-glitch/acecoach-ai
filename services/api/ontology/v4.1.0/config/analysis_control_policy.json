      "finish_control": {
        "head": 0.4,
        "recovery": 0.38,
        "repeatability": 0.22
      }
    },
    "phases": [
      {
        "id": "readiness",
        "label": "Ready position & footwork",
        "weight": 0.1,
        "component_weights": {
          "base_control": 0.55,
          "head_control": 0.45
        },
        "note": "Body-scaled base width and head stability before the stroke.",
        "basis": "2d_pose_control_proxy"
      },
      {
        "id": "preparation",
        "label": "Preparation & backlift",
        "weight": 0.16,
        "component": "preparation_control",
        "note": "Relative time allocated to preparation before forward acceleration.",
        "basis": "temporal_phase_proxy"
      },
      {
        "id": "loading",
        "label": "Body loading & positioning",
        "weight": 0.15,
        "component": "loading_control",
        "note": "The visible knee-bend load before the forward swing; leg drive is scored separately.",
        "basis": "world_pose_angle_proxy"
      },
      {
        "id": "acceleration",
        "label": "Forward swing rhythm",
        "weight": 0.17,
        "component": "acceleration_control",
        "note": "Whole-chain motion shape, with post-load knee drive included where the stroke policy supports it.",
        "basis": "smoothed_pose_motion_signal"
      },
      {
        "id": "contact",
        "label": "Contact-position proxy",
        "weight": 0.18,
        "component": "contact_control",
        "confidence_multiplier": 0.82,
        "note": "Body-scaled hand spacing and head control at peak whole-chain motion; the ball is not detected.",
        "basis": "peak_motion_proxy"
      },
      {
        "id": "follow_through",
        "label": "Follow-through & finish",
        "weight": 0.13,
        "component": "finish_control",
        "note": "Post-peak body control, head stability, and repeatability.",
        "basis": "post_peak_control_proxy"
      },
      {
        "id": "recovery",
        "label": "Recovery",
        "weight": 0.11,
        "component": "recovery_control",
        "note": "Post-peak motion decay, body-relative head control, and reset timing; court recovery is not directly measured.",
        "basis": "post_peak_motion_decay_proxy"
      }
    ]
  },
  "reliability": {
    "policy_id": "AC-RELIABILITY-001",
    "minimum_capture_score": 58,
    "minimum_pose_coverage": 0.7,
    "maximum_edge_clipping_ratio": 0.2,
    "minimum_body_height_ratio": 0.28,
    "minimum_repetitions_for_score": 2,
    "low_measurement_confidence_notice": 0.60,
    "unknown_classification_confidence": 0.35,
    "classification_confidence_floor": 0.3
  },
  "comparisons": {
    "maximum_capture_score_difference": 15,
    "improved_score_delta": 4,
    "unchanged_lower_score_delta": -4,
    "require_same_engine": true,
    "require_same_runtime": true,
    "require_same_context": true,
    "require_same_knowledge_policy": true,
    "require_same_manifest_hash": true
  },
  "longitudinal": {
    "distribution_spread_divisor": 2,
    "minimum_history_sessions": 2,
    "history_window_sessions": 3,
    "meaningful_shift_points": 4
  },
  "recommendations": {
    "policy_id": "AC-RECOMMEND-001",
    "require_supported_fault": true,
    "require_configured_drill_link": true,
    "maximum_active_cues": 1,
    "maximum_drills": 3,
    "candidate_ranking": {
      "maximum_candidates": 3,
      "minimum_confidence_factor": 0.35,
      "impact_weights": {
        "footwork_base": 1.12,
        "backlift_preparation": 1.10,
        "contact_spacing": 1.08,
        "body_position": 1.05,
        "lower_body_loading": 1.02,
        "lower_body_extension": 1.04,
        "hand_swing_path": 1.00,
        "ending_position": 0.96,
        "repeatability": 0.94
      }
    },
    "no_supported_fault": {
      "headline": "No specific technique fault is supported by this recording",
      "main_priority": "Record a few more clear swings before choosing a technique change.",
      "why_it_matters": "The measured pattern is not specific enough to choose one technical correction responsibly.",
      "practice_focus": [
        "Keep the same camera view and shot intention.",
        "Record at least six complete repetitions.",
        "Change no more than one practice constraint before reassessment."
      ],
      "cue": "Same setup. Complete strokes. Clear video."
    }
  },
  "benchmarks": {
    "policy_id": "AC-BENCHMARK-001",
    "require_runtime_release": true,
    "personal_baseline_policy": "knowledge_validation_policy.personal_baseline",
    "matched_cohort_policy": "knowledge_validation_policy.matched_cohort",
    "forbid_unreleased_numeric_reference": true,
    "legacy_records_eligible": false,
    "unreleased_reference": {
      "cohort_label": "No validated matched cohort",
      "comparison_type": "none",
      "status": "withheld_no_released_numeric_reference",
      "disclaimer": "No numeric peer or elite benchmark is released for this context. The report uses governed movement evidence and, when enough matching history exists, the player's own reliable baseline.",
      "next_step": "Record comparable repetitions to build a personal baseline. Peer benchmarks remain hidden until a consented, context-matched cohort passes validation and release governance."
    }
  },
  "records": {
    "policy_id": "AC-RECORD-001",
    "required_trace_fields": [
      "status",
      "policyVersion",
      "ontologyVersion",
      "manifestHash",
      "domains"
    ],
    "legacy_mode": "read_only_excluded_from_derived_records",
    "require_controlled_source_for_longitudinal_state": true,
    "require_same_policy_version_for_comparison": true,
    "require_same_manifest_hash_for_comparison": true
  },
  "report": {
    "policy_id": "AC-REPORT-001",
    "require_control_trace": true,
    "legacy_mode": "reanalyze_to_unlock_coaching",
    "allow_ui_inference": false,
    "withhold_unreleased_benchmarks": true
  }
}
