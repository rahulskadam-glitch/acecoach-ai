{
  "version": "1.0.0",
  "ontology_version": "4.1.0",
  "default_state": "fail_closed",
  "fail_closed": true,
  "required_domains": [
    "calculations",
    "insights",
    "recommendations",
    "benchmarks",
    "records",
    "report"
  ],
  "domains": {
    "calculations": {
      "policy_ids": [
        "AC-SCORE-001",
        "AC-RELIABILITY-001"
      ],
      "rule": "Every derived score must use the versioned scoring policy and carry its policy identifier. Raw models may measure signals but may not assign coaching meaning."
    },
    "insights": {
      "policy_ids": [
        "AC-INSIGHT-001"
      ],
      "rule": "A player-facing insight requires an ontology evidence decision. No report or UI fallback may invent a cause, correction, or priority."
    },
    "recommendations": {
      "policy_ids": [
        "AC-RECOMMEND-001"
      ],
      "rule": "A technical cue or drill requires a supported ontology fault and a configured fault-to-drill link. Only one cue may be active in a practice block."
    },
    "benchmarks": {
      "policy_ids": [
        "AC-BENCHMARK-001"
      ],
      "rule": "Numeric comparisons require a released personal baseline or a validated, context-matched cohort. Qualitative research patterns must not be presented as percentiles or ideal numbers."
    },
    "records": {
      "policy_ids": [
        "AC-RECORD-001"
      ],
      "rule": "Completed reports and derived development records must persist the control policy version, ontology manifest hash, and authorization trace. Legacy untraced records are read-only and excluded from comparison."
    },
    "report": {
      "policy_ids": [
        "AC-REPORT-001"
      ],
      "rule": "The report renders only authorized engine output. Missing authorization suppresses the affected section and requests a governed reanalysis."
    }
  },
  "scoring": {
    "policy_id": "AC-SCORE-001",
    "capture_quality": {
      "core_landmark_visibility_minimum": 0.55,
      "score_scale": 100.0,
      "framing_clipping_penalty": 130.0,
      "body_height_floor": 0.18,
      "body_height_span": 0.42,
      "brightness_target": 0.52,
      "brightness_penalty": 220.0,
      "contrast_multiplier": 82.0,
      "blur_log_ceiling": 401.0,
      "weights": {
        "visibility": 0.34,
        "framing": 0.24,
        "body_scale": 0.16,
        "brightness": 0.10,
        "contrast": 0.06,
        "blur": 0.10
      },
      "grade_minimums": {
        "excellent": 85,
        "good": 72,
        "usable": 58,
        "limited": 42
      },
      "feedback_thresholds": {
        "core_coverage_good": 0.85,
        "edge_clipping_good_maximum": 0.05,
        "body_height_good_minimum": 0.38,
        "brightness_low": 0.20,
        "brightness_high": 0.88,
        "blur_low": 35.0
      }
    },
    "supported_sports": [
