    "evidence_direction_score_boundary": 78,
    "coaching_area_status": {
      "strength_minimum": 78,
      "developing_minimum": 62
    },
    "repetition_analysis": {
      "duration_floor_seconds": 0.001,
      "mean_epsilon": 0.000001,
      "outlier_penalty_cap": 22.0,
      "outlier_penalty_each": 7.0,
      "consistency_base": 100.0,
      "duration_cv_weight": 58.0,
      "peak_cv_weight": 32.0,
      "percentage_scale": 100.0,
      "stable_minimum": 80,
      "developing_minimum": 62,
