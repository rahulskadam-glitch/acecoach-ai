{
  "version": "1.0.0",
  "reviewed_at": "2026-08-15",
  "principle": "Sources establish coaching questions, qualitative patterns, language and study hypotheses. They do not create player percentiles, ideal angles or causal diagnoses.",
  "minimum_coverage": {
    "authority_tier_a_sources_per_stroke": 2,
    "governing_body_source_per_stroke": 1,
    "peer_reviewed_or_coaching_science_source_per_stroke": 1
  },
  "claim_routes": {
    "pose_observable": {
      "allowed_when": ["metric_recipe_exists", "camera_supported", "measurement_confidence_gate_passed"],
      "examples": ["preparation timing", "body-scaled spacing", "balance proxy", "segment timing proxy"]
    },
    "ball_or_racket_observable": {
      "allowed_when": ["validated_tracker_present", "held_out_quality_gate_passed", "capture_suitable"],
      "otherwise": "athlete_or_coach_confirmation_only"
    },
    "outcome_association": {
      "allowed_when": ["validated_outcome_label", "context_matched", "minimum_repetition_count_met"],
      "forbidden": ["cause claim from correlation", "outcome inferred from pose alone"]
    },
    "numeric_benchmark": {
      "allowed_when": ["validated_cohort_version", "matching_cohort_cell", "minimum_sample_size_met", "uncertainty_reported"],
      "otherwise": "withhold"
    }
  },
